# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=False
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
RELOAD=True
WORKERS=4

# API Keys - Get from respective services
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_ai

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_EXPIRY=3600

# Vector Database
VECTOR_DB_TYPE=faiss
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENV=your_pinecone_env

# LLM Settings
DEFAULT_LLM_MODEL=claude-3-opus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Feature Flags
ENABLE_VISION=True
ENABLE_AUDIO=True
ENABLE_VIDEO=True
ENABLE_CODE_EXECUTION=True
ENABLE_WEB_SEARCH=True

# Size Limits
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=524288000

# Code Execution
CODE_EXECUTION_TIMEOUT=30
CODE_EXECUTION_MAX_MEMORY=512

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Search
SEARCH_RESULTS_COUNT=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/nexus_ai.log

# Memory
MEMORY_RETENTION_DAYS=30
SHORT_TERM_MEMORY_TOKENS=1000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
